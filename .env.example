# HTTP bind address inside the container.
HTTP_ADDR=:8080

# Streamable MCP endpoint path. Give agents: https://your-host/mcp
MCP_PATH=/mcp

# Shared secret required in Authorization: Bearer <token>.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-a-long-random-token

# Optional. Set to true only for local debugging without a token.
MCP_ALLOW_INSECURE=false

# Yandex OAuth token from oauth.yandex.ru (not a browser login flow).
YANDEX_WEBMASTER_TOKEN=replace-me-with-oauth-token

# Optional API root. Keep the /v4 suffix.
YANDEX_WEBMASTER_BASE_URL=https://api.webmaster.yandex.net/v4

# Bounded Yandex work per installation. Attempts include the initial request.
YANDEX_REQUEST_TIMEOUT=30s
YANDEX_MAX_CONCURRENT=8
YANDEX_MAX_ATTEMPTS=3
MCP_MAX_BODY_BYTES=1048576

# For an automated collector, disable writes entirely.
MCP_READ_ONLY=true
# Alternatively mount secrets and unset the corresponding inline variable:
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_token
# YANDEX_WEBMASTER_TOKEN_FILE=/run/secrets/yandex_token
